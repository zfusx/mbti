# Copy to .env and replace the password before local use.
POSTGRES_DB=mbti
POSTGRES_USER=mbti
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://mbti:replace-with-a-long-random-password@localhost:5432/mbti
HTTP_PORT=8080
ALLOWED_ORIGIN=http://localhost:4200
QUESTION_COUNT=92
